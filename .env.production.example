# Copy to .env.production only on the deployment host. Never commit the real file.
DEBUG=false
SECRET_KEY=replace-with-at-least-64-random-characters
JWT_SIGNING_KEY=replace-with-an-independent-64-character-random-secret

POSTGRES_DB=giftcard_shop
POSTGRES_USER=giftcard_shop
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

REDIS_PASSWORD=replace-with-a-strong-redis-password
REDIS_URL=redis://:replace-with-a-strong-redis-password@redis:6379/0
CELERY_BROKER_URL=redis://:replace-with-a-strong-redis-password@redis:6379/0
CELERY_RESULT_BACKEND=redis://:replace-with-a-strong-redis-password@redis:6379/0

INVENTORY_FERNET_KEYS=replace-with-a-valid-fernet-key
INVENTORY_FINGERPRINT_KEY=replace-with-a-stable-random-secret-at-least-64-characters

PUBLIC_BASE_URL=https://api.example.com
FRONTEND_URL=https://shop.example.com
ALLOWED_HOSTS=api.example.com,web
CORS_ALLOWED_ORIGINS=https://shop.example.com
CSRF_TRUSTED_ORIGINS=https://shop.example.com,https://api.example.com
TRUST_PROXY=true
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false
AUTH_COOKIE_SECURE=true

# Keep empty in production. The application ignores it when DEBUG=false.
DEVELOPMENT_OTP_CODE=
SMS_API_URL=https://sms-provider.example/api/template/send
SMS_API_KEY=replace-with-provider-api-key
SMS_TEMPLATE_ID=replace-with-provider-template-id

PAYMENT_GATEWAY=zarinpal
ZARINPAL_MERCHANT_ID=replace-with-zarinpal-merchant-id
# Keep true for the final staging test; change to false only for the approved live launch.
ZARINPAL_SANDBOX=true

TOROB_FEED_KEY=replace-with-a-long-random-feed-key
LOG_LEVEL=INFO
