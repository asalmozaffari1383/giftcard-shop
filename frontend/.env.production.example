# The browser uses the same-origin /api/backend proxy. This URL is used only by the Next.js server.
INTERNAL_API_URL=http://web:8000/api/v1
NEXT_PUBLIC_SITE_URL=https://shop.example.com
NEXT_PUBLIC_BUSINESS_NAME=replace-with-legal-business-name
NEXT_PUBLIC_SUPPORT_PHONE=replace-with-public-support-phone
NEXT_PUBLIC_SUPPORT_HOURS=replace-with-support-hours
NEXT_PUBLIC_BUSINESS_ADDRESS=replace-with-legal-business-address
NEXT_PUBLIC_ENAMAD_URL=replace-with-enamad-verification-url
NEXT_PUBLIC_ENAMAD_LOGO_URL=replace-with-enamad-logo-url
AUTH_COOKIE_SECURE=true
